# Local development defaults — committed on purpose (no secrets here).
#
# Next.js loads this file only when NODE_ENV=development (i.e. `next dev`), and
# NOT for production builds (`next build` / `next start`). So local dev points at
# the Firebase emulator out of the box — no `.env.local` needed — while real
# deploys read real credentials from the environment.
#
# These are the emulator's standard localhost addresses (see firebase.json) and a
# throwaway project id. Override anything here in `.env.local`, which takes
# precedence (e.g. to run dev against a real Firebase project).

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=stockpilot-local
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key

FIREBASE_PROJECT_ID=stockpilot-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
