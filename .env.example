# Copy to .env.local and fill in. .env.local is gitignored (ADR 0004, core-belief #4).
# For local development against the Firebase emulator you can leave the real
# credentials blank and keep the emulator settings at the bottom.

# --- Firebase client SDK (safe to expose; only identifies the project) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=stockpilot-local
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER ONLY — never expose; service-account creds) ---
FIREBASE_PROJECT_ID=stockpilot-local
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n escapes, wrapped in quotes.
FIREBASE_PRIVATE_KEY=

# --- Local emulator (set USE_FIREBASE_EMULATOR=1 to target the emulators) ---
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
