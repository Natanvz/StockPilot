# Template for DEPLOYING against a real Firebase project.
#
# You do NOT need this for local development — `npm run dev` auto-targets the
# Firebase emulator via the committed `.env.development`. Only copy this to
# `.env.local` (gitignored) when connecting to a real Firebase project, or when
# deploying. `.env.local` overrides `.env.development`. (ADR 0004, core-belief #4.)

# --- Firebase client SDK (safe to expose; only identifies the project) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER ONLY — never expose; service-account creds) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n escapes, wrapped in quotes.
FIREBASE_PRIVATE_KEY=

# Leave NEXT_PUBLIC_USE_FIREBASE_EMULATOR unset (or 0) for a real project.
